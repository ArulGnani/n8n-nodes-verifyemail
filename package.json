{
	"name": "n8n-nodes-tryverifyemail",
	"version": "0.1.0",
	"description": "VerifyEmail is a real-time email verification service. This n8n community node verifies an address, fetches a check that is still running and reads your credit balance, using your own VerifyEmail API key.",
	"license": "MIT",
	"homepage": "https://github.com/ArulGnani/n8n-nodes-verifyemail#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"verifyemail",
		"email verification",
		"email validation"
	],
	"author": {
		"name": "ArulGnani",
		"email": "team@tryverifyemail.com",
		"url": "https://github.com/ArulGnani"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ArulGnani/n8n-nodes-verifyemail.git"
	},
	"bugs": {
		"url": "https://github.com/ArulGnani/n8n-nodes-verifyemail/issues",
		"email": "team@tryverifyemail.com"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"check": "n8n-node build && node check.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/VerifyEmailApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/VerifyEmail/VerifyEmail.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.50.4",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "19.2.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
